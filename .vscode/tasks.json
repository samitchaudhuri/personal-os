{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Slides: Build PDF",
      "type": "shell",
      "command": "node presentations/tools/run-active-file.js build-slides \"${file}\"",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Slides: Build PPTX",
      "type": "shell",
      "command": "node presentations/tools/run-active-file.js build-pptx \"${file}\"",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Slides: Build Combined PPTX",
      "type": "shell",
      "command": "node presentations/tools/run-active-file.js build-combined \"${file}\" --deck-only",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Slides: PPT brief + assets",
      "type": "shell",
      "command": "node presentations/tools/run-active-file.js build-ppt \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "Slides: Extract Mermaid",
      "type": "shell",
      "command": "node presentations/tools/run-active-file.js slides:extract \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "Slides: Finish (MEP fallback)",
      "type": "shell",
      "command": "node presentations/tools/run-active-file.js slides:finish \"${file}\"",
      "problemMatcher": []
    }
  ]
}
